# Example environment configuration for Aconsys
# Copy this file to ".env" and replace the example values with your own.

# Full path to the Aconsys executable file.
# Example: "C:\Program Files (x86)\Aconsys\AconsysApp.exe"
ACONSYS_EXECUTABLE_FILE_PATH = "C:\\Path\\To\\Aconsys\\Executable.exe"

# The address of the Aconsys server.
# Example: "192.168.1.10"
ACONSYS_SERVER = your_aconsys_server_here

# The name of the database used by Aconsys.
# Example: "AconsysDB"
ACONSYS_DATABASE = your_database_name_here

# The username used to log into the Aconsys system.
# Example: "admin" or "user123"
ACONSYS_USERNAME = your_aconsys_username_here

# The password for the above user.
# Example: "mypassword123"
ACONSYS_PASSWORD = your_aconsys_password_here

COMPRAS_RUC_TEST = your_compras_ruc_here
COMPRAS_SERIE_TEST = your_compras_serie_here
COMPRAS_COMPROBANTE_TEST = your_compras_comprobante_here
COMPRAS_ACCOUNT_NUMBER_TEST = your_compras_account_number_here

ALQUILERES_RUC_TEST = your_alquileres_ruc_here
ALQUILERES_SERIE_TEST = your_alquileres_serie_here
ALQUILERES_COMPROBANTE_TEST = your_alquileres_comprobante_here
FIRST_ALQUILERES_ACCOUNT_NUMBER_TEST = your_first_alquileres_account_number_here
SECOND_ALQUILERES_ACCOUNT_NUMBER_TEST = your_second_alquileres_account_number_here